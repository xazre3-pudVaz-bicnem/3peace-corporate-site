# ============================================================
# 3Peace - 環境変数サンプル
# .env.local にコピーして値を入力してください
# ============================================================

# --- 必須 -----------------------------------------------------
# 本番ドメイン（末尾スラッシュなし）
#
# 【重要】ブラウザで実際に表示されるURLをそのまま入れてください。
# このサイトは apex（wwwなし）から www へリダイレクトする設定のため、
# 正しい値は www 付きです。www なしを入れるとリダイレクトが循環します。
#
#   ✅ https://www.3peace-hiroshima.com
#   ❌ https://3peace-hiroshima.com      ← www へ転送される側なので不可
#
# 未設定の場合は Vercel の本番ドメイン（*.vercel.app）が使われるため、
# canonical・sitemap・OG が独自ドメインになりません。必ず設定してください。
NEXT_PUBLIC_SITE_URL=https://www.3peace-hiroshima.com

# --- お問い合わせ / 応募メール（Resend） ------------------------
# 未設定の場合、フォームは送信不可状態になり、
# 画面には電話・Instagram での問い合わせ導線のみ表示されます。
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- 計測・所有権確認（任意） ----------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
