# ============================================================
# 3Peace - 環境変数サンプル
# .env.local にコピーして値を入力してください
# ============================================================

# --- 必須 -----------------------------------------------------
# 本番ドメイン（末尾スラッシュなし）
# 未設定の場合、canonical / OG / sitemap を出力せず、robots.txt は
# 全ページ Disallow になります（プレビューURLの誤インデックス防止）。
NEXT_PUBLIC_SITE_URL=

# --- お問い合わせ / 応募メール（Resend） ------------------------
# 未設定の場合、フォームは送信不可状態になり、
# 画面には電話・Instagram での問い合わせ導線のみ表示されます。
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- 計測・所有権確認（任意） ----------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
